# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.Python

# Env files (contain secrets)
# 개별 나열 대신 패턴으로 — .env.test.bak / .env.test.old 같은 사본이 이전엔 그대로 통과했다.
# 값이 없는 템플릿(.env.example)만 예외로 추적한다.
.env
.env.*
!.env.example

# Runtime state files
bot_command_queue*.json
bot_heartbeat*.json
track_applications_cache_*.json
track_applications_admin_mock_cache_*.json
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# bkit / agent tooling
.bkit/
.claude/

# Local backups
.pre-pull-backup-*/
*.backup
*.bak
*.old

# Local deploy scripts (not version-controlled — different machines need different paths)
scripts/deploy-oracle.sh
scripts/push-and-deploy.sh
.claude/settings.local.json

# 구글 캘린더 동기화
gcal_calendars.*.json
*service-account*.json
client_secret_*.json
# 서비스 계정 키는 파일명이 제각각이라 패턴으로 막는다
*credentials*.json

# 기수 설정 — 서버 런타임 상태다. 커밋하면 다른 운영자의 서버 값을 덮어써 사고가 난다
cohort_config_*.json
